# ========================================================
# J.A.R.V.I.S. AI Assistant - Environment Configuration
# ========================================================

# AI Provider Keys
# Option 1: Groq API Key (Recommended - 100% Free at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Option 2: Google Gemini API Key (Optional at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Local Desktop Automation (set to 'false' if hosting on cloud containers)
ENABLE_LOCAL_AUTOMATION=true

# Server Port
PORT=8000
